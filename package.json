{
  "name": "barristar-law-firm",
  "version": "1.0.0",
  "description": "Modern law firm website layout with Tailwind CSS and TypeScript",
  "main": "dist/index.js",
  "scripts": {
    "build": "npm run build:css && npm run build:ts",
    "build:css": "tailwindcss -i ./src/styles/input.css -o ./dist/styles/output.css --watch",
    "build:ts": "tsc",
    "dev": "concurrently \"npm run build:css\" \"npm run build:ts -- --watch\" \"live-server dist\"",
    "serve": "node serve.js",
    "start": "node serve.js"
  },
  "keywords": ["law", "firm", "tailwind", "typescript", "barristar"],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "live-server": "^1.2.2",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "express": "^4.18.2"
  }
}
